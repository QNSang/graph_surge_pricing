{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pipeline_run_id": {
      "type": "string",
      "minLength": 1
    },
    "trial_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "CREATED",
        "PREFLIGHT",
        "VALIDATING",
        "DERIVING",
        "TRAINING",
        "EVALUATING",
        "PACKAGING",
        "SUCCEEDED",
        "SUCCEEDED_WITH_WARNINGS",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "tracking_sync": {
      "enum": [
        "PENDING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "quality_status": {
      "enum": [
        "UNASSESSED",
        "PASSED",
        "FAILED"
      ]
    },
    "export_status": {
      "enum": [
        "NOT_REQUESTED",
        "PASSED",
        "FAILED"
      ]
    },
    "mlflow_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "derived_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "epoch_completed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "global_optimizer_step": {
      "type": "integer",
      "minimum": 0
    },
    "last_checkpoint_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_checkpoint_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resume_parent_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message_sanitized": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "verified"
        ]
      }
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "run_role": {
      "enum": [
        "trial",
        "selected_final_eval",
        "analysis",
        "package",
        "preflight"
      ]
    },
    "parent_mlflow_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "pipeline_run_id",
    "trial_id",
    "attempt_id",
    "request_id",
    "revision",
    "status",
    "stage",
    "tracking_sync",
    "quality_status",
    "export_status",
    "mlflow_run_id",
    "source_fingerprint",
    "derived_fingerprint",
    "config_sha256",
    "code_digest",
    "epoch_completed",
    "global_optimizer_step",
    "last_checkpoint_uri",
    "last_checkpoint_sha256",
    "started_at_utc",
    "updated_at_utc",
    "heartbeat_at_utc",
    "resume_parent_attempt_id",
    "error_code",
    "error_message_sanitized",
    "warnings",
    "artifact_receipts",
    "study_id",
    "run_role",
    "parent_mlflow_run_id"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:graph-surge:run-state:1.0",
  "title": "Durable run state",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SUCCEEDED",
              "SUCCEEDED_WITH_WARNINGS"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tracking_sync": {
            "const": "COMPLETE"
          }
        }
      }
    }
  ]
}
