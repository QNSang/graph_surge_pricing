{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_id": {
      "const": "dual_gru_gatv2_h5_v1_2"
    },
    "feature_contract_id": {
      "const": "hex29_edge10_v1_2"
    },
    "target_contract_id": {
      "const": "ds_log1p_h5_v1_2"
    },
    "graph_contract_id": {
      "const": "directed_relations_self_v1"
    },
    "output_domain": {
      "const": "softplus_log1p_v1"
    },
    "target_inverse": {
      "const": "expm1"
    },
    "window_steps": {
      "const": 12
    },
    "horizon_minutes": {
      "const": 5
    },
    "node_count": {
      "type": "integer",
      "minimum": 1
    },
    "node_dim": {
      "const": 29
    },
    "raw_edge_dim": {
      "const": 10
    },
    "internal_edge_dim": {
      "const": 12
    },
    "output_head_order": {
      "const": [
        "local",
        "graph"
      ]
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "derived_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalizer_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "node_mapping_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_kind": {
      "const": "synthetic"
    },
    "deployment_eligible": {
      "const": false
    },
    "quality_status": {
      "enum": [
        "UNASSESSED",
        "PASSED",
        "FAILED"
      ]
    },
    "export_status": {
      "enum": [
        "NOT_REQUESTED",
        "PASSED",
        "FAILED"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "best_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "selection_metric": {
      "const": "val/graph/mae_q/h5"
    },
    "selection_value": {
      "type": "number",
      "minimum": 0
    },
    "serving_format": {
      "enum": [
        "eager",
        "pt2"
      ]
    },
    "runtime_profile": {
      "type": "string",
      "minLength": 1
    },
    "runtime_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_parquet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Frozen inventory semantic digest of public raw/features/burn_in Parquet; separate from legacy training fingerprint."
    },
    "source_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Byte digest of source schema.yaml, bound alongside the ordered feature contract and Parquet inventory."
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "feature_contract_id",
    "target_contract_id",
    "graph_contract_id",
    "output_domain",
    "target_inverse",
    "window_steps",
    "horizon_minutes",
    "node_count",
    "node_dim",
    "raw_edge_dim",
    "internal_edge_dim",
    "output_head_order",
    "source_fingerprint",
    "derived_fingerprint",
    "config_sha256",
    "code_digest",
    "normalizer_sha256",
    "node_mapping_sha256",
    "dataset_kind",
    "deployment_eligible",
    "quality_status",
    "export_status",
    "run_id",
    "best_epoch",
    "selection_metric",
    "selection_value",
    "serving_format",
    "runtime_profile",
    "runtime_versions",
    "created_at_utc",
    "source_parquet_sha256",
    "source_schema_sha256"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:graph-surge:model-metadata:1.0",
  "title": "V1.2 synthetic research bundle metadata",
  "allOf": [
    {
      "if": {
        "properties": {
          "serving_format": {
            "const": "pt2"
          }
        }
      },
      "then": {
        "properties": {
          "export_status": {
            "const": "PASSED"
          }
        }
      }
    }
  ]
}
