      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "const": "1.0"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "const": "v12"
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "study_id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "name",
            "study_id",
            "description",
            "seed"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_root": {
              "type": "string",
              "minLength": 1
            },
            "expected_source_id": {
              "type": "string",
              "minLength": 1
            },
            "expected_source_fingerprint": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$",
              "description": "Recorded fingerprint of the 13 legacy training payload files; not a digest of raw/features/burn_in Parquet."
            },
            "expected_feature_contract": {
              "type": "string",
              "minLength": 1,
              "const": "hex40_edge10_v2.1"
            },
            "expected_node_count": {
              "type": "integer",
              "minimum": 1
            },
            "verify_checksums": {
              "type": "boolean",
              "const": true
            },
            "derived_root": {
              "type": "string",
              "minLength": 1
            },
            "dataset_kind": {
              "type": "string",
              "minLength": 1,
              "const": "synthetic"
            },
            "availability_policy": {
              "type": "string",
              "minLength": 1,
              "const": "event_time_only_mock"
            },
            "source_format": {
              "type": "string",
              "const": "hcm_v2_parquet"
            },
            "parquet_inventory_policy": {
              "type": "string",
              "const": "raw_features_burn_in_v1"
            },
            "expected_source_parquet_sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "derivative_storage": {
              "type": "string",
              "const": "mmap_npy"
            },
            "source_layout_id": {
              "type": "string",
              "const": "hcm_v2_parquet_tree_v1"
            },
            "manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "feature_contract_path": {
              "type": "string",
              "minLength": 1
            },
            "source_schema_path": {
              "type": "string",
              "minLength": 1
            },
            "legacy_archive_root": {
              "type": "null",
              "const": null
            }
          },
          "required": [
            "source_root",
            "expected_source_id",
            "expected_source_fingerprint",
            "expected_feature_contract",
            "expected_node_count",
            "verify_checksums",
            "derived_root",
            "dataset_kind",
            "availability_policy",
            "source_format",
            "parquet_inventory_policy",
            "expected_source_parquet_sha256",
            "derivative_storage",
            "source_layout_id",
            "manifest_path",
            "feature_contract_path",
            "source_schema_path",
            "legacy_archive_root"
