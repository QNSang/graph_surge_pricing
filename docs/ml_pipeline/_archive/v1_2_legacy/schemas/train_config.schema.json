{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:graph-surge:train-config:1.0",
  "title": "Surge ML training specification configuration",
  "description": "Strict structural schema; cross-field/hash/index semantics require implementation validators described in chapter03.",
  "oneOf": [
    {
      "$ref": "#/definitions/v12"
    },
    {
      "$ref": "#/definitions/legacy_replay"
    }
  ],
  "definitions": {
