# Copy values to an untracked environment file during implementation.
# Local development clients:
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Team profile requires all three values below; no default credential or version is invented.
# PostgreSQL image MUST be an approved exact tag/digest compatible with the chosen driver.
# POSTGRES_IMAGE=postgres:<approved-version>@sha256:<verified-digest>
# PSYCOPG2_VERSION=<exact-version-tested-at-M1>
# Use a randomly generated hex password so the URI and raw password representations agree.
# MLFLOW_DB_PASSWORD=<generated-hex-secret>

# Authentication variables are supplied only if the deployed gateway/server supports them.
# Never log their values or commit the actual file.
# MLFLOW_TRACKING_USERNAME=<identity>
# MLFLOW_TRACKING_PASSWORD=<secret>
